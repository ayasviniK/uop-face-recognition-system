# ─────────────────────────────────────────────────────────────────
# Sentinel — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────────

# ── MySQL Database ────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/uop_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT Authentication ────────────────────────────────────────────
# Any long random string — minimum 32 characters
JWT_SECRET=uop_sentinel_super_secret_key_2026_peradeniya

# ── Internal API Key ──────────────────────────────────────────────
# Flask uses this to call Spring Boot's /internal/* endpoints
# Must be the same value in both Spring Boot and sync_university.py
INTERNAL_API_KEY=sentinel_internal_key_2026

# ── Service URLs ──────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5000
SPRING_BOOT_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── University Index API ──────────────────────────────────────────
# Returns student info (index, faculty etc.) for a given reg number
# Call format: UNIVERSITY_INDEX_URL/{reg_no}
# e.g. https://api.university.lk/students/A/16/AI/877
UNIVERSITY_INDEX_URL=https://FILL_IN_WHEN_YOU_GET_ACCESS/students

# ── University Photo DB API ───────────────────────────────────────
# Returns the student's passport photo for a given student index
# Call format: PHOTO_DB_URL/{student_index}
PHOTO_DB_URL=https://FILL_IN_WHEN_YOU_GET_ACCESS/photos

# ── University API Credentials ────────────────────────────────────
# Fill in whichever authentication method the university uses:

# Option 1: Username + Password (basic auth)
UNI_API_USERNAME=
UNI_API_PASSWORD=

# Option 2: API Key
UNI_API_KEY=

# ── University API Field Names ────────────────────────────────────
# Update these once you see the actual API response
# e.g. if API returns {"registration_no": "A/16/AI/877"} set UNI_FIELD_INDEX=registration_no
UNI_FIELD_INDEX=index
UNI_FIELD_FACULTY=faculty_id
